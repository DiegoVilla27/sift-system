# ==============================================================================
# SIFT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Google Gemini API key for automated job evaluation, match scoring, and ATS response generation
GEMINI_API_KEY="your-google-gemini-api-key-here"

# Discord Webhook URL for real-time notification alerts (match scores, application confirmations)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# Application Branding
NEXT_PUBLIC_APP_NAME="Sift System"

# Playwright Browser Automation Runtime Configuration
# Set to 'true' for headless CI/production execution, or 'false' to inspect visual browser automation
PLAYWRIGHT_HEADLESS=true
